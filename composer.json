{
  "name": "circus-circuli/kirby-altcha-captcha",
  "description": "Self-hosted, privacy-friendly ALTCHA proof-of-work captcha for Kirby forms.",
  "type": "kirby-plugin",
  "license": "MIT",
  "keywords": ["kirby", "kirby-plugin", "captcha", "altcha", "spam"],
  "require": {
    "php": ">=8.2",
    "getkirby/composer-installer": "^1.2",
    "altcha-org/altcha": "^2.3"
  },
  "require-dev": {
    "getkirby/cms": "^5.0"
  },
  "autoload": {
    "psr-4": {
      "CircusCirculi\\Altcha\\": "src/"
    }
  },
  "extra": {
    "installer-name": "kirby-altcha-captcha"
  },
  "config": {
    "allow-plugins": {
      "getkirby/composer-installer": true
    },
    "optimize-autoloader": true
  }
}
